{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "idm-rs",
  "version": "0.3.0",
  "identifier": "com.idmrs.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "idm-rs",
        "width": 1000,
        "height": 640,
        "minWidth": 860,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/idm-cli",
      "binaries/idm-nmhost"
    ],
    "resources": {
      "resources/idm-rs-firefox.xpi": "idm-rs-firefox.xpi"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "template": "nsis/installer.nsi",
        "installerHooks": "nsis/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU0QjZENEQwM0I0NzRDMTMKUldRVFRFYzcwTlMyVkE5MExBcWdCRlh5eHRjY01tajIwSE81bnVFZXp0M2E4bWVSUkxnRW40dkkK",
      "endpoints": [
        "https://github.com/aihuihao/idm-rs/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
