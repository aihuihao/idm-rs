{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "idm-rs",
  "version": "0.1.1",
  "identifier": "com.idmrs.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "idm-rs",
        "width": 1000,
        "height": 640,
        "minWidth": 860,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": [
      "binaries/idm-cli",
      "binaries/idm-nmhost"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "template": "nsis/installer.nsi",
        "installerHooks": "nsis/hooks.nsh"
      }
    }
  }
}
